# Copy this file to .env and fill it in. Never commit .env.
# Gmail needs 2-Step Verification on, then an App Password (not the account password).

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional
MAIL_FROM_NAME=EcoCrete
MAIL_REPLY_TO=hello@ecocrete.ph
MAIL_BCC=owner@example.com
PORT=4173
